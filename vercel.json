{
	"builds": [
		{
			"src": "package.json",
			"use": "@vercel/next"
		}
	],
	"buildCommand": "npm run vercel-build",
	"installCommand": "npm install",
	"crons": [
		{
			"path": "/api/cron/escalate",
			"schedule": "*/10 * * * *"
		},
		{
			"path": "/api/cron/retry-deliveries",
			"schedule": "*/15 * * * *"
		},
		{
			"path": "/api/cron/expire-vouchers",
			"schedule": "0 2 * * *"
		}
	]
}
