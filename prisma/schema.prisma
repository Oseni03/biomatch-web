generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  donor
  hospital
  admin
}

enum Availability {
  weekdays
  weekends
  mornings
  afternoons
  evenings
  anytime
}

enum UrgencyLevel {
  standard
  critical
}

enum RequestStatus {
  pending
  matched
  expired
  cancelled
  fulfilled
}

enum AlertStatus {
  alerted
  accepted
  declined
  withdrawn
  en_route
  arrived
  completed
}

enum BloodGroup {
  A_PLUS
  A_MINUS
  B_PLUS
  B_MINUS
  AB_PLUS
  AB_MINUS
  O_PLUS
  O_MINUS
}

model HospitalBank {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceNumber Int      @default(autoincrement())
  hospitalName   String
  location       String
  address        String?
  latitude       Float?
  longitude      Float?
  inventory      Json     @default("{\"A+\": 0, \"A-\": 0, \"B+\": 0, \"B-\": 0, \"AB+\": 0, \"AB-\": 0, \"O+\": 0, \"O-\": 0}")
  organizationId String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  donations    Donation[]

  @@unique([sequenceNumber])
  @@index([organizationId])
  @@index([latitude, longitude])
  @@map("hospital_banks")
}

model Donation {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donorId            String     @db.Uuid
  hospitalBankId     String?    @db.Uuid
  emergencyRequestId String?    @db.Uuid
  bloodGroup         BloodGroup
  donatedAt          DateTime   @default(now()) @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)

  donor            User              @relation("DonorDonations", fields: [donorId], references: [id], onDelete: Restrict)
  hospitalBank     HospitalBank?     @relation(fields: [hospitalBankId], references: [id], onDelete: SetNull)
  emergencyRequest EmergencyRequest? @relation(fields: [emergencyRequestId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([hospitalBankId])
  @@index([donatedAt])
  @@map("donations")
}

model Wallet {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @db.Uuid
  points            Int      @default(0)
  lifetimeDonations Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model EmergencyRequest {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @db.Uuid
  bloodGroup     BloodGroup
  unitsNeeded    Int
  urgencyLevel   UrgencyLevel  @default(standard)
  status         RequestStatus @default(pending)
  searchRadius   Int           @default(15)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  alerts       EmergencyAlert[]
  donations    Donation[]

  @@index([organizationId])
  @@index([bloodGroup])
  @@index([status])
  @@index([createdAt])
  @@map("emergency_requests")
}

model EmergencyAlert {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId        String      @db.Uuid
  donorId          String      @db.Uuid
  status           AlertStatus @default(alerted)
  openedAt         DateTime?   @db.Timestamptz(6)
  respondedAt      DateTime?   @db.Timestamptz(6)
  donorConfirmedAt DateTime?   @db.Timestamptz(6)
  hospitalConfirmedAt DateTime? @db.Timestamptz(6)
  responseReason   String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)

  request          EmergencyRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor            User              @relation("DonorAlerts", fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorId])
  @@index([requestId])
  @@index([donorId])
  @@index([status])
  @@map("emergency_alerts")
}

model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  email             String
  emailVerified     Boolean            @default(false)
  image             String?
  bloodGroup        BloodGroup?
  genotype          String?
  role              Role               @default(donor)
  updatedHealthInfo Json               @default("{}")
  location          String?
  address           String?
  latitude          Float?
  longitude         Float?
  availability      Availability?
  isActive          Boolean            @default(true)
  lastDonationDate  DateTime?          @db.Timestamptz(6)
  deferredUntil     DateTime?          @db.Timestamptz(6)
  blacklistedAt     DateTime?          @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  sessions                Session[]
  accounts                Account[]
  wallet                  Wallet?
  emergencyAlerts         EmergencyAlert[]   @relation("DonorAlerts")
  donations               Donation[]         @relation("DonorDonations")
  members                 Member[]
  sentInvitations         Invitation[]

  @@unique([email])
  @@index([role])
  @@index([bloodGroup])
  @@index([latitude, longitude])
  @@index([lastDonationDate])
  @@index([role, isActive, bloodGroup, blacklistedAt])
  @@map("user")
}

model Session {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
  ipAddress            String?
  userAgent            String?
  userId               String   @db.Uuid
  activeOrganizationId String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  logo      String?
  metadata  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @db.Timestamptz(6)

  members           Member[]
  invitations       Invitation[]
  hospitalBanks     HospitalBank[]
  emergencyRequests EmergencyRequest[]

  @@map("organization")
}

model Member {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @default("member")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  role           String
  status         String   @default("pending")
  expiresAt      DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  inviterId      String   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}
